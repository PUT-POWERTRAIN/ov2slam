%YAML 1.0
---

#--------------------------------------------------------------------------------------------
# Camera Parameters for Pohang00 dataset
#--------------------------------------------------------------------------------------------

Camera.topic_left: /stereo/left/image_raw
Camera.topic_right: /stereo/right/image_raw

Camera.model_left: pinhole
Camera.model_right: pinhole

Camera.left_nwidth: 2048
Camera.left_nheight: 1080

Camera.right_nwidth: 2048
Camera.right_nheight: 1080

# Camera calibration and distortion parameters (OpenCV)
# From pohang00 calibration/stereo_left
Camera.fxl: 1814.5061420730431
Camera.fyl: 1814.5061420730431
Camera.cxl: 1026.1977130691339
Camera.cyl: 524.7984412358129

Camera.k1l: -0.082292808267338341
Camera.k2l: 0.1036602731851739
Camera.p1l: -0.0034940032414059268
Camera.p2l: 0.00084014002308057311

# From pohang00 calibration/stereo_right
Camera.fxr: 1812.26306845315
Camera.fyr: 1812.26306845315
Camera.cxr: 1041.300936202379
Camera.cyr: 519.07223080294409

Camera.k1r: -0.080226526918819735
Camera.k2r: 0.093063204690196202
Camera.p1r: -0.0029454095837901139
Camera.p2r: 0.0011427467119549529

# Camera Extrinsic parameters T_b_ci ( v_b = T_b_ci * v_ci )
# From pohang00 calibration/extrinsics.json
body_T_cam0: !!opencv-matrix
   rows: 4
   cols: 4
   dt: d
   data: [0.008043815704157353, -0.005517664520102383, 0.9999524250718939, 5.036254972834461,
          0.9998467500712979, -0.015504951501656983, -0.008128520824554841, -0.4410102127584988,
          0.015549064305658333, 0.999864566757506, 0.005392099966026742, -1.771000242852925,
          0., 0., 0., 1.]

body_T_cam1: !!opencv-matrix
   rows: 4
   cols: 4
   dt: d
   data: [0.007004664649612025, -0.014382858696194878, 0.9998720258357426, 5.010057439449895,
          0.9999590718253071, -0.005624998547419047, -0.007086188369781921, 0.4023181598949916,
          0.005726198338948163, 0.9998807392719729, 0.014342868803562281, -1.7616651319571297,
          0., 0., 0., 1.]

#--------------------------------------------------------------------------------------------
# SLAM Parameters. Adjust them!
#--------------------------------------------------------------------------------------------
debug: 1
log_timings: 0

mono: 0
stereo: 1

force_realtime: 1

# Estimator Mode
slam_mode: 1

# Loop Closing mode
buse_loop_closer: 0

# Stereo rectify or not
bdo_stereo_rect: 0
alpha: 0.

# Undist Image or not
bdo_undist: 0

# Init / KF px th.
finit_parallax: 20.

# Features Extractor
use_shi_tomasi: 0
use_fast: 1
use_brief: 1
use_singlescale_detector: 0

# Min dist between kps (define the number of kps)
# Increased from 50 to 100 for higher resolution images (2048x1080)
# Original 50 would give ~900 kps, 100 gives ~220 kps
nmaxdist: 100

# Features quality th.
nfast_th: 10
dmaxquality: 0.001

# Pre-processing
use_clahe: 0
fclahe_val: 3

# KLT related settings.
do_klt: 1
klt_use_prior: 1
btrack_keyframetoframe: 0
nklt_win_size: 9
nklt_pyr_lvl: 3

# Opencv Default: 30 iters. + 0.01 prec.
nmax_iter: 30
fmax_px_precision: 0.01

fmax_fbklt_dist: 0.5
nklt_err: 30.

# Matching th.
bdo_track_localmap: 1

fmax_desc_dist: 0.2
fmax_proj_pxdist: 2.

# Randomize RANSAC?
doepipolar: 0
dop3p : 1
bdo_random: 1
nransac_iter: 100
fransac_err: 3.

# Reproj err th.
fmax_reproj_err: 3.
buse_inv_depth: 1

# Ceres related parameters
robust_mono_th: 5.9915

use_sparse_schur: 1
use_dogleg: 0
use_subspace_dogleg: 0
use_nonmonotic_step: 0

# Estimator parameters
apply_l2_after_robust: 1

nmin_covscore: 25

# Map Filtering
fkf_filtering_ratio: 0.9

# Final Pass
do_full_ba: 0

# Rerun visualization parameters
rerun_map_log_frequency: 10  # Log map points every N frames (0 = disable)
rerun_output_file: "ov2slam.rrd"  # Empty = live viewer, or specify path like "ov2slam.rrd" for file recording

#--------------------------------------------------------------------------------------------
# GPS and AHRS Initialization
#--------------------------------------------------------------------------------------------
GPSInit.use_gps_init: 1
GPSInit.use_ahrs_init: 1
GPSInit.gps_file: "navigation/gps.txt"
GPSInit.ahrs_file: "navigation/ahrs.txt"
