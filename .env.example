# z.ai API credentials
# Get these from your z.ai account
ANTHROPIC_AUTH_TOKEN=your_z_ai_token_here
ANTHROPIC_BASE_URL=https://z.ai

# Optional: Dataset directory (defaults to ~/datasets)
DATASET_DIR=~/datasets

# Optional: User UID/GID (defaults to 1000:1000)
# Set these to match your host user: `id -u` and `id -g`
USER_UID=1000
USER_GID=1000
